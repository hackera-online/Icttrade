<script>
(function(){
  var rig = document.getElementById('rack-rig');
  var scene = document.getElementById('rack-scene');
  if (rig && scene && !window.matchMedia('(prefers-reduced-motion: reduce)').matches){
    scene.addEventListener('mousemove', function(e){
      var r = scene.getBoundingClientRect();
      var px = (e.clientX - r.left) / r.width - 0.5;
      var py = (e.clientY - r.top) / r.height - 0.5;
      rig.style.transform = 'rotateX(' + (18 - py*16) + 'deg) rotateY(' + (-22 + px*24) + 'deg)';
    });
    scene.addEventListener('mouseleave', function(){ rig.style.transform = ''; });
  }

  var header = document.getElementById('site-header');
  window.addEventListener('scroll', function(){
    header.classList.toggle('scrolled', window.scrollY > 12);
  });

  var launch = document.getElementById('chat-launch');
  var panel = document.getElementById('chat-panel');
  var body = document.getElementById('chat-body');
  var input = document.getElementById('chat-input');
  var sendBtn = document.getElementById('chat-send');
  var chips = document.getElementById('chat-chips');
  var opened = false;

  var rules = [
    { keys:['работно','час','кога отвор','отворен'], reply:'Работим Понеделник–Петък, от 10:00 до 17:00 ч.' },
    { keys:['адрес','къде се намирате','офис','локация'], reply:'Намираме се в София, 1505, ул. Георги Минчев 26. Картата долу на страницата показва точното място.' },
    { keys:['телефон','обадя','позвъня','номер'], reply:'Можете да ни звъннете на +359 2 444 7 555 или на мобилния +359 885 21 5555.' },
    { keys:['имейл','поща','mail'], reply:'Пишете ни на office@ict-trade.bg — отговаряме в рамките на работния ден.' },
    { keys:['услуг','продукт','какво предлагате','правите'], reply:'Работим в три направления: настолни компютри и системи, мрежово оборудване (сървъри, сториджи), и киберсигурност за бизнес, институции и дома.' },
    { keys:['мрежа','сървър','storage','мрежово'], reply:'Проектираме и изграждаме мрежова инфраструктура — сървъри, сториджи устройства и всичко за стабилен мрежови сетъп, с компоненти от водещи производители.' },
    { keys:['компютър','настолн','пи си','pc'], reply:'Асемблираме конфигурации по конкретна задача и изграждаме локални мрежи — от избора на компоненти до пускане в експлоатация.' },
    { keys:['сигурност','защита','хакер','кибер'], reply:'Предлагаме решения за киберсигурност, съобразени с профила на клиента — учебно заведение, бизнес, институция или домашна мрежа.' },
    { keys:['оферта','цена','цени','поръчк','бюджет'], reply:'С удоволствие ще подготвим оферта. Оставете ни малко информация на office@ict-trade.bg или ни позвънете на +359 2 444 7 555 — ще се свържем с вас същия работен ден.' },
    { keys:['здрав','здрасти','hi','hello','добър ден'], reply:'Здравейте! С какво мога да помогна — услуги, работно време или контакти?' },
    { keys:['благодар','мерси','thanks'], reply:'Няма проблем! Ако възникне още нещо, пишете ни по всяко време.' }
  ];

  function norm(s){ return s.toLowerCase(); }

  function findReply(text){
    var t = norm(text);
    for (var i=0;i<rules.length;i++){
      for (var j=0;j<rules[i].keys.length;j++){
        if (t.indexOf(rules[i].keys[j]) !== -1) return rules[i].reply;
      }
    }
    return 'Не съм сигурен, че разбрах напълно. Най-сигурно е да ни пишете на office@ict-trade.bg или да позвъните на +359 2 444 7 555 — колега ще отговори лично.';
  }

  function addMsg(text, who){
    var el = document.createElement('div');
    el.className = 'msg ' + who;
    el.textContent = text;
    body.appendChild(el);
    body.scrollTop = body.scrollHeight;
  }

  function botTyping(cb){
    var t = document.createElement('div');
    t.className = 'msg bot typing';
    t.innerHTML = '<span></span><span></span><span></span>';
    body.appendChild(t);
    body.scrollTop = body.scrollHeight;
    setTimeout(function(){
      t.remove();
      cb();
    }, 550 + Math.random()*450);
  }

  function userSend(text){
    if (!text.trim()) return;
    addMsg(text, 'user');
    input.value = '';
    botTyping(function(){
      addMsg(findReply(text), 'bot');
    });
  }

  launch.addEventListener('click', function(){
    opened = !opened;
    launch.classList.toggle('open', opened);
    panel.classList.toggle('open', opened);
    if (opened && body.children.length === 0){
      botTyping(function(){
        addMsg('Здравейте! Аз съм асистентът на ИКТ ТРЕЙД. Питайте за услуги, работно време или контакти — или изберете от бутоните долу.', 'bot');
      });
    }
    if (opened) input.focus();
  });

  chips.addEventListener('click', function(e){
    var btn = e.target.closest('.chip');
    if (!btn) return;
    userSend(btn.dataset.q);
  });

  sendBtn.addEventListener('click', function(){ userSend(input.value); });
  input.addEventListener('keydown', function(e){
    if (e.key === 'Enter') userSend(input.value);
  });

  var demoScript = [
    { who:'user', text:'Здравейте, търсим сървър за офис от 20 души.' },
    { who:'bot', text:'Здравейте! Колко потребители ще работят с него едновременно, и имате ли нужда от резервно съхранение (storage)?' },
    { who:'user', text:'Да, искаме и решение за бекъп.' },
    { who:'bot', text:'Разбрано, ще включим сървър с RAID storage за резервни копия. Интересувате ли се и от киберсигурност за мрежата?' },
    { who:'user', text:'Да, важно е за нас.' },
    { who:'bot', text:'Отлично, добавям и базов пакет за киберсигурност. За кога Ви е нужна инфраструктурата готова?' },
    { who:'user', text:'До края на месеца, ако е възможно.' },
    { who:'bot', text:'Готово! Записах запитване за сървър с 20 потребители, RAID storage и киберсигурност, с краен срок до края на месеца. Колега ще Ви прати оферта още днес.' }
  ];
  var demoRunning = false;
  function startDemo(){
    if (demoRunning) return;
    demoRunning = true;
    var demoBody = document.getElementById('demoChatBody');
    var demoReplay = document.getElementById('demoReplay');
    var leadPreview = document.getElementById('leadPreview');
    if (!demoBody) { demoRunning = false; return; }
    demoBody.innerHTML = '';
    leadPreview.classList.remove('shown');
    demoReplay.style.display = 'none';
    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var i = 0;
    function addDemoMsg(msg){
      var el = document.createElement('div');
      el.className = 'msg ' + (msg.who === 'user' ? 'user' : 'bot');
      el.textContent = msg.text;
      demoBody.appendChild(el);
      demoBody.scrollTop = demoBody.scrollHeight;
    }
    function step(){
      if (i >= demoScript.length){
        demoRunning = false;
        demoReplay.style.display = 'inline-flex';
        setTimeout(function(){ leadPreview.classList.add('shown'); }, 250);
        return;
      }
      var msg = demoScript[i];
      if (reduced){ addDemoMsg(msg); i++; step(); return; }
      if (msg.who === 'bot'){
        var t = document.createElement('div');
        t.className = 'msg bot typing';
        t.innerHTML = '<span></span><span></span><span></span>';
        demoBody.appendChild(t);
        demoBody.scrollTop = demoBody.scrollHeight;
        setTimeout(function(){
          t.remove();
          addDemoMsg(msg);
          i++;
          setTimeout(step, 550);
        }, 700 + Math.random()*350);
      } else {
        setTimeout(function(){ addDemoMsg(msg); i++; setTimeout(step, 450); }, 380);
      }
    }
    step();
  }
  var demoReplayBtn = document.getElementById('demoReplay');
  if (demoReplayBtn) demoReplayBtn.addEventListener('click', startDemo);
  var demoWindowEl = document.getElementById('demoChat');
  if (demoWindowEl){
    var demoObs = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if (e.isIntersecting){ setTimeout(startDemo, 400); demoObs.unobserve(e.target); }
      });
    }, { threshold:0.35 });
    demoObs.observe(demoWindowEl);
  }

  document.querySelector('.nav-toggle')?.addEventListener('click', function(){
    var links = document.querySelector('nav.links');
    var visible = links.style.display === 'flex';
