<!DOCTYPE html>
<html lang="bg">
<head>
<meta charset="UTF-8" />
<title>ИКТ ТРЕЙД — Инфраструктура, мрежи и киберсигурност</title>
<meta name="description" content="ИКТ ТРЕЙД доставя компютърни системи, мрежово оборудване и решения за киберсигурност на бизнеса в България." />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#12161b" />
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%2312161b'/%3E%3Crect x='7' y='9' width='18' height='4' fill='%230089D2'/%3E%3Crect x='7' y='15' width='18' height='4' fill='%23e7eaee'/%3E%3Crect x='7' y='21' width='10' height='4' fill='%235B4FE0'/%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#12161b;
    --bg-alt:#1a212a;
    --panel:#1d242d;
    --text:#e7eaee;
    --text-dim:#8b95a1;
    --copper:#0089D2;
    --copper-soft: rgba(0,137,210,0.14);
    --cyan:#5B4FE0;
    --cyan-soft: rgba(91,79,224,0.16);
    --line: rgba(231,234,238,0.12);
    --line-strong: rgba(231,234,238,0.22);
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    background:
      radial-gradient(1100px 620px at 82% -8%, rgba(91,79,224,0.12), transparent 60%),
      radial-gradient(900px 500px at -5% 12%, rgba(0,137,210,0.10), transparent 55%),
      var(--bg);
    color:var(--text);
    font-family:'Sora', sans-serif;
    line-height:1.55;
    -webkit-font-smoothing:antialiased;
  }
  img{max-width:100%;display:block;}
  a{color:inherit;text-decoration:none;}
  .mono{font-family:'Space Mono', monospace;}
  h1,h2,h3,.logo{font-family:'Sora', sans-serif;letter-spacing:-0.01em;}
  .wrap{max-width:1180px;margin:0 auto;padding:0 28px;}
  .overflow-x{overflow-x:auto;}
  ::selection{background:var(--copper-soft);color:var(--text);}
  a:focus-visible, button:focus-visible, input:focus-visible{
    outline:2px solid var(--cyan); outline-offset:2px; border-radius:2px;
  }

  header{
    position:sticky; top:0; z-index:50;
    background:rgba(18,22,27,0.88);
    backdrop-filter:blur(10px);
    border-bottom:1px solid var(--line);
    transition:padding .2s ease;
  }
  .nav-row{display:flex;align-items:center;justify-content:space-between;padding:18px 0;transition:padding .2s ease;}
  header.scrolled .nav-row{padding:12px 0;}
  .logo{font-size:19px;font-weight:700;letter-spacing:0.2px;display:flex;align-items:center;gap:11px;margin-left:2px;transition:transform .18s ease;}
  .logo:hover{transform:translateX(2px);}
  .logo-word span{color:var(--copper);}
  nav.links{display:flex;gap:34px;font-size:15px;color:var(--text-dim);}
  nav.links a{position:relative;padding:4px 0;transition:color .15s ease;}
  nav.links a::after{
    content:"";position:absolute;left:0;right:0;bottom:-2px;height:1px;background:var(--cyan);
    transform:scaleX(0);transform-origin:left;transition:transform .2s ease;
  }
  nav.links a:hover{color:var(--text);}
  nav.links a:hover::after{transform:scaleX(1);}
  .header-phone{font-size:14px;color:var(--text-dim);display:flex;align-items:center;gap:10px;}
  .header-phone a{color:var(--text);font-weight:500;}
  .nav-toggle{display:none;background:none;border:1px solid var(--line-strong);color:var(--text);width:38px;height:38px;border-radius:4px;font-size:16px;cursor:pointer;}

  .hero{
    padding:96px 0 0;
    border-bottom:1px solid var(--line);
    position:relative;
    overflow:hidden;
    background-image:
      linear-gradient(var(--bg) 60%, transparent),
      linear-gradient(90deg, var(--line) 1px, transparent 1px),
      linear-gradient(var(--line) 1px, transparent 1px);
    background-size:100% 100%, 64px 64px, 64px 64px;
    background-position:0 0, -1px -1px, -1px -1px;
  }
  .hero-inner{padding-bottom:56px;}
  .hero-grid{display:grid;grid-template-columns:1.1fr 0.9fr;gap:56px;align-items:center;}
  .eyebrow-line{
    display:flex;align-items:center;gap:10px;
    color:var(--cyan);font-size:13px;margin-bottom:22px;
  }
  .eyebrow-line .dot{width:7px;height:7px;border-radius:50%;background:var(--cyan);animation:pulse 2.4s ease-in-out infinite;}
  @keyframes pulse{
    0%,100%{opacity:1; box-shadow:0 0 0 0 rgba(91,79,224,0.5);}
    50%{opacity:0.55; box-shadow:0 0 0 6px rgba(91,79,224,0);}
  }
  h1{
    font-size:clamp(34px,4.4vw,52px);
    line-height:1.12;
    font-weight:600;
    margin:0 0 22px;
    max-width:15ch;
  }
  .hero p.lead{
    color:var(--text-dim);
    font-size:17px;
    max-width:46ch;
    margin:0 0 34px;
  }
  .cta-row{display:flex;gap:16px;flex-wrap:wrap;align-items:center;}
  .btn{
    display:inline-flex; align-items:center; gap:8px;
    padding:13px 26px;border-radius:3px;
    font-size:15px;font-weight:500;border:none;cursor:pointer;
    font-family:inherit;transition:background .15s ease, border-color .15s ease, transform .1s ease;
  }
  .btn:active{transform:translateY(1px);}
  .btn-primary{background:var(--copper);color:#12161b;}
  .btn-primary:hover{background:#2BA3E0;}
  .btn-ghost{border:1px solid var(--line-strong);color:var(--text);background:none;}
  .btn-ghost:hover{border-color:var(--text-dim);}

  .scene-3d{
    width:100%;aspect-ratio:1/1;max-width:400px;margin:0 auto;
    perspective:900px;
  }
  .rig{
    width:100%;height:100%;position:relative;transform-style:preserve-3d;
    transform:rotateX(18deg) rotateY(-22deg);
    animation:rig-float 7s ease-in-out infinite;
    transition:transform .3s ease-out;
  }
  @keyframes rig-float{
    0%,100%{transform:rotateX(18deg) rotateY(-22deg) translateY(0);}
    50%{transform:rotateX(15deg) rotateY(-18deg) translateY(-10px);}
  }
  .unit{
    position:absolute;left:50%;width:230px;height:56px;
    margin-left:-115px;border-radius:5px;
    background:linear-gradient(180deg,var(--panel),var(--bg-alt));
    border:1px solid var(--line-strong);
    box-shadow:0 24px 40px -18px rgba(0,0,0,0.6);
    display:flex;align-items:center;gap:8px;padding:0 14px;
    transform-style:preserve-3d;
  }
  .unit .led{width:7px;height:7px;border-radius:50%;background:var(--cyan);animation:blink 3s ease-in-out infinite;}
  .unit .led.copper{background:var(--copper);animation-delay:.8s;}
  .unit .bars{margin-left:auto;display:flex;gap:3px;}
  .unit .bars i{width:3px;height:14px;background:var(--line-strong);border-radius:1px;}
  .u1{top:0;transform:translateZ(30px);}
  .u2{top:66px;transform:translateZ(12px);}
  .u3{top:132px;transform:translateZ(-8px);}
  .u4{top:198px;transform:translateZ(-26px);}
  .shield-3d{
    position:absolute;right:-6px;top:-18px;width:66px;height:66px;
    transform:translateZ(70px) rotateY(0deg);
    animation:shield-spin 6s ease-in-out infinite;
    filter:drop-shadow(0 10px 18px rgba(0,0,0,.5));
  }
  @keyframes shield-spin{
    0%,100%{transform:translateZ(70px) rotateY(-10deg);}
    50%{transform:translateZ(70px) rotateY(18deg);}
  }
  @keyframes blink{0%,100%{opacity:.3;}50%{opacity:1;}}

  .stat-strip{
    border-top:1px solid var(--line); background:var(--bg-alt);
    display:grid; grid-template-columns:repeat(4,1fr);
  }
  .stat-strip div{
    padding:22px 24px; border-right:1px solid var(--line);
    perspective:600px;
  }
  .stat-strip div:last-child{border-right:none;}
  .stat-num{
    font-family:'Space Mono',monospace; font-size:22px; color:var(--cyan);
    display:inline-block; transform-style:preserve-3d;
    animation:flip-in 900ms cubic-bezier(.2,.8,.2,1) both;
  }
  .stat-strip div:nth-child(2) .stat-num{animation-delay:.1s;}
  .stat-strip div:nth-child(3) .stat-num{animation-delay:.2s;}
  .stat-strip div:nth-child(4) .stat-num{animation-delay:.3s;}
  @keyframes flip-in{
    from{transform:rotateX(70deg) translateY(6px); opacity:0;}
    to{transform:rotateX(0) translateY(0); opacity:1;}
  }
  .stat-label{display:block;font-size:12.5px;color:var(--text-dim);margin-top:4px;}
  @media (max-width:860px){ .stat-strip{grid-template-columns:1fr 1fr;} }

  section{padding:80px 0;border-bottom:1px solid var(--line);}
  .section-head{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;margin-bottom:44px;flex-wrap:wrap;}
  h2{font-size:28px;font-weight:600;margin:0;max-width:22ch;}
  .section-note{color:var(--text-dim);font-size:14px;max-width:34ch;text-align:right;}

  .spec-row{
    display:grid;
    grid-template-columns:90px 1fr 1.4fr;
    gap:28px;
    padding:28px 0;
    border-top:1px solid var(--line);
    align-items:start;
    transition:background .15s ease;
  }
  .spec-row:hover{background:rgba(231,234,238,0.02);}
  .spec-row:last-child{border-bottom:1px solid var(--line);}
  .spec-code{color:var(--copper);font-size:13px;letter-spacing:0.03em;padding-top:4px;}
  .spec-name{font-size:19px;font-weight:600;}
  .spec-desc{color:var(--text-dim);font-size:15px;max-width:56ch;}

  .about-grid{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:start;}
  .about-grid p{color:var(--text-dim);font-size:15.5px;margin:0 0 18px;max-width:52ch;}
  .capability-list{display:grid;gap:0;border-top:1px solid var(--line);}
  .capability-list div{
    display:flex;justify-content:space-between;gap:16px;
    padding:16px 0;border-bottom:1px solid var(--line);font-size:14.5px;
  }
  .capability-list span:first-child{color:var(--text);}
  .capability-list span:last-child{color:var(--text-dim);}

  .seg-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line);border:1px solid var(--line);perspective:800px;}
  .seg{background:var(--bg);padding:30px 26px;transition:background .15s ease, transform .25s ease;transform-style:preserve-3d;}
  .seg:hover{background:var(--bg-alt);transform:rotateX(6deg) rotateY(-4deg) translateZ(6px);}
  .seg .mono{color:var(--cyan);font-size:12.5px;display:block;margin-bottom:14px;}
  .seg h3{font-size:16.5px;font-weight:600;margin:0 0 10px;}
  .seg p{color:var(--text-dim);font-size:14px;margin:0;}

  .contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:56px;}
  .contact-lines div{
    display:flex;justify-content:space-between;padding:15px 0;border-top:1px solid var(--line);font-size:14.5px;
  }
  .contact-lines div:last-child{border-bottom:1px solid var(--line);}
  .contact-lines span:first-child{color:var(--text-dim);}
  .contact-lines a{font-weight:500;}
  .map-frame{border:1px solid var(--line);border-radius:4px;overflow:hidden;height:100%;min-height:260px;}
  .map-frame iframe{width:100%;height:100%;min-height:260px;border:0;filter:grayscale(0.4) invert(0.92) contrast(0.9);}

  footer{padding:40px 0;}
  .footer-row{display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap;color:var(--text-dim);font-size:13.5px;}
  .footer-row a{color:var(--text-dim);}
  .footer-row a:hover{color:var(--text);}

  #chat-launch{
    position:fixed; right:26px; bottom:26px; z-index:80;
    width:58px; height:58px; border-radius:50%;
    background:var(--copper); border:none; cursor:pointer;
    display:flex; align-items:center; justify-content:center;
    box-shadow:0 8px 24px rgba(0,0,0,0.35), 0 0 0 0 rgba(0,137,210,0.5);
    animation:launch-pulse 2.6s ease-out 1.2s 3;
    transition:background .15s ease, transform .15s ease;
  }
  #chat-launch:hover{background:#2BA3E0; transform:translateY(-2px);}
  @keyframes launch-pulse{
    0%{box-shadow:0 8px 24px rgba(0,0,0,0.35), 0 0 0 0 rgba(0,137,210,0.45);}
    70%{box-shadow:0 8px 24px rgba(0,0,0,0.35), 0 0 0 14px rgba(0,137,210,0);}
    100%{box-shadow:0 8px 24px rgba(0,0,0,0.35), 0 0 0 0 rgba(0,137,210,0);}
  }
  #chat-launch svg{width:24px;height:24px;}
  #chat-launch .close-icon{display:none;}
  #chat-launch.open .chat-icon{display:none;}
  #chat-launch.open .close-icon{display:block;}

  #chat-panel{
    position:fixed; right:26px; bottom:96px; z-index:80;
    width:360px; max-width:calc(100vw - 40px);
    height:min(520px, 70vh);
    background:var(--panel);
    border:1px solid var(--line-strong);
    border-radius:10px;
    display:flex; flex-direction:column;
    box-shadow:0 20px 60px rgba(0,0,0,0.45);
    opacity:0; transform:translateY(12px) scale(0.98);
    pointer-events:none;
    transition:opacity .18s ease, transform .18s ease;
  }
  #chat-panel.open{opacity:1; transform:translateY(0) scale(1); pointer-events:auto;}

  .chat-head{
    display:flex; align-items:center; gap:12px;
    padding:16px 18px; border-bottom:1px solid var(--line);
  }
  .chat-avatar{
    width:32px;height:32px;border-radius:50%;
    background:var(--bg-alt); border:1px solid var(--line-strong);
    display:flex;align-items:center;justify-content:center; position:relative; flex-shrink:0;
  }
  .chat-avatar::after{
    content:""; position:absolute; width:8px;height:8px;border-radius:50%;
    background:var(--cyan); bottom:-1px; right:-1px; border:2px solid var(--panel);
  }
  .chat-title{font-size:14.5px;font-weight:600;}
  .chat-sub{font-size:12px;color:var(--text-dim);}

  .chat-body{
    flex:1; overflow-y:auto; padding:16px 18px;
    display:flex; flex-direction:column; gap:10px;
  }
  .msg{max-width:82%; padding:10px 13px; border-radius:10px; font-size:14px; line-height:1.45;}
  .msg.bot{background:var(--bg-alt); align-self:flex-start; border-bottom-left-radius:3px;}
  .msg.user{background:var(--copper); color:#12161b; align-self:flex-end; border-bottom-right-radius:3px;}
  .msg.typing{display:flex; gap:4px; align-items:center; padding:12px 14px;}
  .msg.typing span{width:5px;height:5px;border-radius:50%;background:var(--text-dim);animation:tdot 1.1s ease-in-out infinite;}
  .msg.typing span:nth-child(2){animation-delay:.15s;}
  .msg.typing span:nth-child(3){animation-delay:.3s;}
  @keyframes tdot{0%,60%,100%{opacity:.3;transform:translateY(0);}30%{opacity:1;transform:translateY(-2px);}}

  .chip-row{display:flex;flex-wrap:wrap;gap:8px;padding:0 18px 14px;}
  .chip{
    font-size:12.5px; padding:7px 12px; border-radius:20px;
    border:1px solid var(--line-strong); color:var(--text-dim);
    background:none; cursor:pointer; font-family:inherit;
    transition:border-color .15s ease, color .15s ease;
  }
  .chip:hover{border-color:var(--cyan); color:var(--text);}

  .chat-input-row{
    display:flex; gap:8px; padding:14px 16px;
    border-top:1px solid var(--line);
  }
  .chat-input-row input{
    flex:1; background:var(--bg-alt); border:1px solid var(--line-strong);
    border-radius:20px; padding:10px 16px; color:var(--text); font-size:14px;
    font-family:inherit;
  }
  .chat-input-row input::placeholder{color:var(--text-dim);}
  .chat-send{
    width:38px;height:38px;border-radius:50%;background:var(--copper);
    border:none;display:flex;align-items:center;justify-content:center;cursor:pointer;flex-shrink:0;
  }
  .chat-send:hover{background:#2BA3E0;}
  .chat-send svg{width:16px;height:16px;}

  @media (max-width:480px){
    #chat-panel{
      right:12px; left:12px; width:auto; bottom:90px; height:min(60vh, 480px);
    }
    #chat-launch{right:18px; bottom:18px;}
  }

  /* ---- Embedded AI demo section ---- */
  #ai-demo{
    background:
      radial-gradient(900px 460px at 90% 0%, rgba(91,79,224,0.10), transparent 60%),
      var(--bg-alt);
  }
  .ai-demo-grid{display:grid;grid-template-columns:0.85fr 1.15fr;gap:56px;align-items:start;}
  .demo-copy p.lead{color:var(--text-dim);font-size:15.5px;max-width:44ch;margin:0 0 26px;}
  .demo-flow{display:grid;gap:0;border-top:1px solid var(--line);margin-top:8px;}
  .demo-flow div{display:flex;gap:14px;padding:14px 0;border-bottom:1px solid var(--line);font-size:14px;}
  .demo-flow .step-no{color:var(--copper);font-family:'Space Mono',monospace;font-size:12.5px;padding-top:2px;flex-shrink:0;width:20px;}
  .demo-flow .step-text b{display:block;color:var(--text);font-weight:600;margin-bottom:2px;}
  .demo-flow .step-text span{color:var(--text-dim);}

  .demo-window{
    background:var(--panel); border:1px solid var(--line-strong); border-radius:10px;
    overflow:hidden; box-shadow:0 30px 70px -30px rgba(0,0,0,0.55);
  }
  .demo-window .chat-head{padding:16px 18px;}
  .demo-online{margin-left:auto;font-size:11.5px;color:var(--cyan);white-space:nowrap;}
  .demo-window .chat-body{height:360px; background:var(--bg);}
  .demo-window .msg{opacity:0; transform:translateY(6px); animation:msg-rise .3s ease forwards;}
  @keyframes msg-rise{ to{opacity:1; transform:translateY(0);} }
  .demo-window .chat-input-row{align-items:center;}
  .demo-window .fake-input{
    flex:1; padding:10px 16px; border-radius:20px; background:var(--bg-alt);
    border:1px solid var(--line-strong); color:var(--text-dim); font-size:13.5px;
    white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
  }
  .demo-replay{
    display:none; align-items:center; gap:6px; flex-shrink:0;
    padding:9px 15px; border-radius:20px; border:1px solid var(--line-strong);
    background:none; color:var(--text-dim); font-family:inherit; font-size:13px;
    cursor:pointer; transition:border-color .15s ease, color .15s ease;
  }
  .demo-replay:hover{border-color:var(--cyan); color:var(--text);}

  .lead-preview{
    margin-top:22px; opacity:0; transform:translateY(18px);
    transition:opacity .5s ease, transform .6s cubic-bezier(.2,1.1,.3,1);
  }
  .lead-preview.shown{opacity:1; transform:none;}
  .lead-card{
    background:var(--bg); border:1px solid var(--line-strong); border-radius:8px; overflow:hidden;
  }
  .lead-head{
    display:flex; justify-content:space-between; align-items:center;
    padding:12px 16px; border-bottom:1px solid var(--line); font-size:12px; color:var(--text-dim);
  }
  .lead-head span:first-child{color:var(--copper); font-weight:600;}
  .lead-rows{padding:4px 16px 0;}
  .lead-row{
    display:flex; justify-content:space-between; gap:16px; padding:9px 0;
    font-size:13.5px; border-bottom:1px dashed var(--line);
  }
  .lead-row:last-child{border-bottom:0;}
  .lead-row span:first-child{color:var(--text-dim);}
  .lead-row span:last-child{font-weight:500; text-align:right;}
  .lead-score{
    margin:10px 14px 14px; display:flex; justify-content:space-between; align-items:center;
    padding:10px 14px; border-radius:6px; background:var(--cyan-soft); color:var(--cyan); font-size:12.5px;
  }

  @media (max-width:860px){
    .ai-demo-grid{grid-template-columns:1fr;}
  }
  @media (prefers-reduced-motion: reduce){
    .demo-window .msg{animation:none !important; opacity:1 !important; transform:none !important;}
    .lead-preview{transition:none !important; opacity:1 !important; transform:none !important;}
  }

  @media (max-width:860px){
    .hero-grid{grid-template-columns:1fr;}
    .scene-3d{max-width:280px;}
    nav.links{display:none;}
    .nav-toggle{display:block;}
    .header-phone{display:none;}
    .about-grid, .contact-grid{grid-template-columns:1fr;gap:36px;}
    .seg-grid{grid-template-columns:1fr 1fr;}
    .spec-row{grid-template-columns:60px 1fr;}
    .spec-desc{grid-column:1 / -1;}
    .section-note{text-align:left;}
  }
  @media (max-width:480px){
    .seg-grid{grid-template-columns:1fr;}
  }
  @media (prefers-reduced-motion: reduce){
    .rig, .unit .led, .shield-3d, .eyebrow-line .dot, #chat-launch, .stat-num{animation:none;}
  }
</style>
</head>
<body>

<header id="site-header">
  <div class="wrap nav-row">
    <a href="#site-header" class="logo">
      <span class="logo-word">ИКТ <span>ТРЕЙД</span></span>
    </a>
    <nav class="links">
      <a href="#ai-demo">AI асистент</a>
      <a href="#uslugi">Услуги</a>
